# Copy to .env and fill in. Never commit .env.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Backup chat model, used once if the main one is overloaded (503)
NVIDIA_CHAT_MODEL_FALLBACK=nvidia/nemotron-3.5-lightning-30b-a3b
# true = every AI endpoint returns canned answers (use on stage if Wi-Fi is bad)
DEMO_FALLBACK=false
# Postgres connection for the gw_app user (pooled host, SSL). Local .env + Netlify env vars only. Never commit it.
DATABASE_URL=postgresql://gw_app:<password>@<pooled-host>/<database>?sslmode=require
# Code reviewers type on #/review (approve / reject / reset demo data). Required on the live site.
REVIEW_CODE=
