INSERT INTO wishes (id, beneficiary_id, organization_id, category, title, description, story_context, estimated_cost, amount_raised, currency, urgency, status, relay_point, city, region, tags, deadline, created_at, country, country_code, submission_source) VALUES
    ('728191fc-78bb-4d30-84ed-05d086507780', 'e4fcf372-9bce-4433-856f-fcaa86c8dd33', '3ea517ac-d04e-424a-8b97-fd75cea3b199', 'education', 'A school bag, fully stocked', 'Notebooks, pens, a compass set, and a bag sturdy enough to last the whole year.', 'The new school year starts in a few weeks and the old bag no longer holds together. A full set of supplies would mean one less thing to worry about on the first day. The child is looking forward to showing up with a bag that matches everyone else''s.', 150.0, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Casablanca', 'Casablanca', 'Casablanca-Settat', ARRAY['school','supplies','back-to-school'], NULL, '2026-09-15T10:15:00', 'Morocco', 'MA', 'seed'),
    ('2ece4167-d341-4c48-89d2-304d407ce985', '4e319579-bf19-4670-8954-adf7c74cead3', '84a782c9-53d8-4c6a-999d-ba67a5819f9a', 'education', 'A full set of school books', 'This year''s required textbooks, bought new so nothing is missing.', 'The reading list came out last week and several titles are missing from what was passed down from an older sibling. Borrowed copies work for a while, but homework gets harder without the right edition. Having the complete set from day one would keep the term on track.', 230.0, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Agadir', 'Agadir', 'Souss-Massa', ARRAY['school','textbooks'], NULL, '2026-06-04T10:15:00', 'Morocco', 'MA', 'seed'),
    ('a4fda092-cd87-46f1-9022-98184eefd1a1', '565b8975-f91f-4460-b45c-2db9a3d744be', '6cecbcd7-33de-4bd9-8a6a-6c7458c2ecc6', 'education', 'A study lamp for evening homework', 'A simple desk lamp so homework does not have to wait for daylight.', 'Evenings at home are shared between several children and the overhead light is not enough for reading small print. A small desk lamp would let homework get done properly after dinner. It is a small item, but it makes a real difference for late-evening study.', 140.0, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Rabat', 'Rabat', 'Rabat-Sale-Kenitra', ARRAY['school','study'], NULL, '2026-06-11T10:15:00', 'Morocco', 'MA', 'seed'),
    ('132cebfe-2773-4ca7-8d3e-f9def6993ae4', '1f5dd5a9-6feb-431f-b615-42775167a51e', 'fbc85d60-db78-42f8-8131-0c694c6ff3fc', 'education', 'A calculator for the new school year', 'A basic scientific calculator required for this year''s math and science classes.', 'The math curriculum this year introduces topics that need a proper calculator, and borrowing one from a classmate is only a temporary fix. Owning one means being able to practice at home as well as in class. It is a small investment with a direct effect on grades.', 110.0, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Fes', 'Fes', 'Fes-Meknes', ARRAY['school','supplies'], NULL, '2026-08-08T10:15:00', 'Morocco', 'MA', 'seed'),
    ('1c8e9e6b-4f28-4ea5-a3cf-7d3d859c545e', '565b8975-f91f-4460-b45c-2db9a3d744be', '6cecbcd7-33de-4bd9-8a6a-6c7458c2ecc6', 'essentials', 'A wool blanket for winter', 'Thick enough for a cold night without heating.', 'Nights get cold and the room has no heating, so extra layers make the biggest difference. A proper wool blanket would mean warmer, more restful sleep through the winter months. It is one of the simplest gifts that changes daily comfort right away.', 395.31, 0.0, 'MAD', 'high', 'open', 'Relay point — partner association, Rabat', 'Rabat', 'Rabat-Sale-Kenitra', ARRAY['winter','comfort','urgent'], '2026-12-20', '2026-03-07T10:15:00', 'Morocco', 'MA', 'seed'),
    ('4c74df8a-c6b6-4615-83c8-1dc4ee3ba56f', 'eb7b065a-9f64-45f4-bd10-f2a8d37af3b1', '9ff42d11-404f-4e6f-b6cf-5a7c9467ddaa', 'essentials', 'A month of hygiene essentials', 'Soap, toothpaste, shampoo and other basics for one month.', 'Hygiene items run out quietly and are easy to overlook when a household is stretched thin. A month''s supply covers the basics without anyone having to choose between essentials and something else. It is a modest request that supports everyday dignity and health.', 178.02, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Marrakech', 'Marrakech', 'Marrakech-Safi', ARRAY['essentials','hygiene'], NULL, '2026-05-26T10:15:00', 'Morocco', 'MA', 'seed'),
    ('11cd8c93-b3e5-444f-ac68-d958b9d3e203', '1f5dd5a9-6feb-431f-b615-42775167a51e', 'fbc85d60-db78-42f8-8131-0c694c6ff3fc', 'essentials', 'New bedsheets and a pillow', 'A full bedding set to replace ones that are worn through.', 'The current sheets have been patched more than once and the pillow has lost its shape entirely. A fresh set would mean better sleep and one less source of daily discomfort. It is a quiet need that rarely gets noticed until it is fixed.', 202.42, 172.06, 'MAD', 'high', 'partially_funded', 'Relay point — partner association, Fes', 'Fes', 'Fes-Meknes', ARRAY['essentials','home'], NULL, '2026-09-05T10:15:00', 'Morocco', 'MA', 'seed'),
    ('c598d18d-dc67-4c90-a9c3-961d65e93905', '556c78a7-baab-46aa-843b-7a0069838891', '945e29b0-0001-413e-bbcb-a38c021ca8c5', 'essentials', 'A water heater repair', 'Parts and labor to fix a broken water heater before winter.', 'The water heater has been out for weeks, so every wash is done with cold water regardless of the season. A repair would restore hot water for bathing and dishes before the cold months set in. It is a practical fix that affects the whole household every single day.', 477.73, 477.73, 'MAD', 'low', 'funded', 'Relay point — partner association, Tangier', 'Tangier', 'Tanger-Tetouan-Al Hoceima', ARRAY['essentials','home','urgent'], NULL, '2026-08-22T10:15:00', 'Morocco', 'MA', 'seed'),
    ('60aa6706-e71a-4e16-8247-66b1ae5783d4', 'b9adbd76-819d-4875-9157-ea52f843b657', '84a782c9-53d8-4c6a-999d-ba67a5819f9a', 'creative', 'A drawing set for a child who draws every day', 'Colored pencils, a sketchpad, and a box of paints.', 'Drawing is the one activity that reliably calms this child down after a difficult day. The current pencils are worn to stubs and the paper has mostly run out. A fresh set would keep that outlet open through the rest of the year.', 104.13, 104.13, 'MAD', 'medium', 'delivered', 'Relay point — partner association, Agadir', 'Agadir', 'Souss-Massa', ARRAY['creativity','hobby'], NULL, '2026-04-09T10:15:00', 'Morocco', 'MA', 'seed'),
    ('283c06b6-d46b-4a3a-957c-7e146eb1921e', '66c0920e-723e-4c9d-846f-5e6db1a6c98a', '4d043fe2-3be7-499a-ac31-037505e8a572', 'creative', 'A beginner guitar', 'An entry-level acoustic guitar and a basic instruction book.', 'For the past year, practice has meant borrowing an instrument for an hour at a time from a neighbor. Having a guitar at home would allow for real, regular practice instead of occasional sessions. Music has become one of the few things this child looks forward to each week.', 188.62, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Casablanca', 'Casablanca', 'Casablanca-Settat', ARRAY['creativity','music'], NULL, '2026-06-08T10:15:00', 'Morocco', 'MA', 'seed'),
    ('98b3e534-4093-4790-b3d7-ca9dbd9a6f2d', '30e69e67-65d8-488e-8812-5b04eeab0cd6', '12f42589-2f85-4e77-af05-b4ea9aa3317a', 'creative', 'A sewing kit for a young tailor', 'Needles, thread, fabric scraps and a small pair of scissors.', 'Watching the older women in the family sew sparked an interest that has not faded in months. A basic kit would let that interest turn into a real skill, practiced on scrap fabric at home. It is a small, inexpensive way to encourage a growing talent.', 169.8, 0.0, 'MAD', 'medium', 'open', 'Relay point — partner association, Oujda', 'Oujda', 'L''Oriental', ARRAY['creativity','skills'], NULL, '2026-03-13T10:15:00', 'Morocco', 'MA', 'seed'),
    ('bb6555e6-1473-46b9-8eba-214da6d07ac8', '565b8975-f91f-4460-b45c-2db9a3d744be', '6cecbcd7-33de-4bd9-8a6a-6c7458c2ecc6', 'creative', 'A box of building blocks', 'A large set of interlocking blocks for open-ended play.', 'Shared toys get passed between many children and rarely stay in one place for long. A set of building blocks that belongs to just this child would support hours of quiet, constructive play. It is a simple gift with a lasting effect on a young imagination.', 198.38, 178.54, 'MAD', 'medium', 'partially_funded', 'Relay point — partner association, Rabat', 'Rabat', 'Rabat-Sale-Kenitra', ARRAY['creativity','play'], NULL, '2026-04-22T10:15:00', 'Morocco', 'MA', 'seed'),
    ('594eea80-9365-4738-b348-90a5cb7d0c3e', 'dba9ff93-102d-4bad-ae41-b03c72c6ddb7', '9ff42d11-404f-4e6f-b6cf-5a7c9467ddaa', 'family_care', 'Three months of infant formula', 'One tin a month, for a baby whose family is between jobs.', 'The baby is too young for solid food and formula is the household''s single largest weekly expense right now. Three months of coverage would give the family room to get back on their feet without that particular worry. It is time-sensitive support for a need that cannot wait.', 364.05, 364.05, 'MAD', 'low', 'funded', 'Relay point — partner association, Marrakech', 'Marrakech', 'Marrakech-Safi', ARRAY['baby','nutrition','urgent'], NULL, '2026-04-23T10:15:00', 'Morocco', 'MA', 'seed'),
    ('19ff297f-bdb8-4fd0-8545-edba667087d7', '0c2f2000-d567-4e17-8dfe-e35fe292c510', 'fbc85d60-db78-42f8-8131-0c694c6ff3fc', 'family_care', 'A crib for a newborn', 'A safe place for a newborn to sleep, away from the family bed.', 'The newborn currently sleeps in a shared bed out of necessity rather than choice. A proper crib would give the baby a safer place to rest and free up space for the rest of the household at night. It is a first, essential piece of furniture for a growing family.', 358.55, 358.55, 'MAD', 'low', 'delivered', 'Relay point — partner association, Fes', 'Fes', 'Fes-Meknes', ARRAY['baby','home'], NULL, '2026-07-13T10:15:00', 'Morocco', 'MA', 'seed'),
    ('45fae97b-217a-4a58-9aaf-10a31f972ad2', '7e956758-9f1e-4198-b6b4-0a9ffd18d456', '945e29b0-0001-413e-bbcb-a38c021ca8c5', 'family_care', 'A stroller for daily errands', 'A sturdy secondhand-quality stroller for getting around with a toddler.', 'Without a stroller, every errand means carrying a toddler on foot across town, which is exhausting and slow. A stroller would make daily trips for food and appointments far more manageable. It is a practical tool that saves time and effort every single day.', 316.02, 0.0, 'MAD', 'medium', 'open', 'Relay point — partner association, Tangier', 'Tangier', 'Tanger-Tetouan-Al Hoceima', ARRAY['baby','essentials'], NULL, '2026-06-07T10:15:00', 'Morocco', 'MA', 'seed'),
    ('53995fe1-2f9a-4eb6-aeb5-ed6492eaa17c', 'b9adbd76-819d-4875-9157-ea52f843b657', '84a782c9-53d8-4c6a-999d-ba67a5819f9a', 'family_care', 'Diapers for two months', 'A steady supply of diapers to cover eight weeks.', 'Diapers are a recurring cost that adds up quickly and is easy to underestimate from the outside. Two months of coverage would give the family breathing room to handle other, less predictable expenses. It is a small, concrete way to support a household with a very young child.', 478.11, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Agadir', 'Agadir', 'Souss-Massa', ARRAY['baby','essentials'], NULL, '2026-05-03T10:15:00', 'Morocco', 'MA', 'seed'),
    ('9ce877ef-b5d4-4626-af86-5a93776e550b', '167652da-1e6b-4cfb-9d3f-6e47d3c88a8a', '4d043fe2-3be7-499a-ac31-037505e8a572', 'health', 'A month of chronic illness medication', 'Essential medication to cover one month of treatment.', 'Treatment has to be taken daily without interruption, and missing doses puts real progress at risk. One month of medication would keep the routine uninterrupted while the family manages other costs. It is ongoing, time-critical support rather than a one-time gift.', 393.55, 362.07, 'MAD', 'high', 'partially_funded', 'Relay point — partner association, Casablanca', 'Casablanca', 'Casablanca-Settat', ARRAY['health','critical','medical'], '2026-11-30', '2026-05-01T10:15:00', 'Morocco', 'MA', 'seed'),
    ('2887c1da-3f14-420d-9e46-8af9ae91ea06', '013b2c71-49a2-49f1-b7c7-0176cc514cad', '12f42589-2f85-4e77-af05-b4ea9aa3317a', 'health', 'A course of physical therapy', 'Ten rehabilitation sessions needed after a surgery.', 'Recovery has been slower than expected and the recommended sessions have had to be postponed more than once. A full course of therapy would help regain mobility before the gap becomes harder to close. Each session builds on the last, so consistency matters more than anything else.', 628.97, 628.97, 'MAD', 'critical', 'funded', 'Relay point — partner association, Oujda', 'Oujda', 'L''Oriental', ARRAY['health','medical','critical'], '2026-12-20', '2026-07-15T10:15:00', 'Morocco', 'MA', 'seed'),
    ('90fa7597-d944-4461-8007-ebbaf54e11b3', '565b8975-f91f-4460-b45c-2db9a3d744be', '6cecbcd7-33de-4bd9-8a6a-6c7458c2ecc6', 'health', 'Eyeglasses for a child', 'A vision test and a first pair of prescription glasses.', 'Squinting at the board in class has become a daily habit that a recent check-up finally explained. A proper pair of glasses would make schoolwork noticeably easier and less tiring. It is a one-time cost with an immediate, visible benefit.', 312.84, 312.84, 'MAD', 'critical', 'delivered', 'Relay point — partner association, Rabat', 'Rabat', 'Rabat-Sale-Kenitra', ARRAY['health','medical'], '2026-11-15', '2026-08-01T10:15:00', 'Morocco', 'MA', 'seed'),
    ('d13211e3-5090-4fd2-afe0-9d1e754f742d', '78304599-3a8a-4658-b960-ce993322f6f7', '9ff42d11-404f-4e6f-b6cf-5a7c9467ddaa', 'health', 'A wheelchair cushion', 'A pressure-relief cushion for daily wheelchair use.', 'Long hours in a wheelchair without proper cushioning have started to cause real discomfort. A pressure-relief cushion would make daily use safer and far more comfortable. It is a small piece of equipment that protects long-term health.', 779.61, 0.0, 'MAD', 'critical', 'open', 'Relay point — partner association, Marrakech', 'Marrakech', 'Marrakech-Safi', ARRAY['health','medical','mobility'], '2026-12-10', '2026-05-17T10:15:00', 'Morocco', 'MA', 'seed'),
    ('ab2c18ec-626f-49bb-bbe1-2704f3eea9f4', '0707a521-8fda-4c08-a6ef-75de0c0f0c33', 'fbc85d60-db78-42f8-8131-0c694c6ff3fc', 'clothing', 'A winter coat that fits', 'Hers is torn and outgrown from last year.', 'The coat from last winter no longer closes and the fabric has worn through at the seams. A properly fitting coat would make the walk to and from school through the cold months far more bearable. It is a seasonal need that comes back every year around this time.', 256.22, 0.0, 'MAD', 'high', 'open', 'Relay point — partner association, Fes', 'Fes', 'Fes-Meknes', ARRAY['winter','clothing'], '2026-12-20', '2026-05-17T10:15:00', 'Morocco', 'MA', 'seed'),
    ('6cdb41a0-2927-4e35-bad0-460c438cba66', 'cb1ad52e-0fd7-4292-9b37-b3ce419493de', '33ea7b67-f593-4a2b-a04f-c92ca8f47ce3', 'clothing', 'A full set of school uniforms', 'Two full uniform sets, sized for this year.', 'The uniform policy is strict and the current set no longer fits after a growth spurt over the summer. Two sets would allow for one to be washed while the other is worn, which the family cannot currently manage. It is a routine but unavoidable back-to-school cost.', 156.44, 76.66, 'MAD', 'high', 'partially_funded', 'Relay point — partner association, Ouarzazate', 'Ouarzazate', 'Draa-Tafilalet', ARRAY['clothing','school'], NULL, '2026-03-26T10:15:00', 'Morocco', 'MA', 'seed'),
    ('8a3b6a67-1c45-4f63-bcf3-44eddadb7677', '4933d89e-0a74-414d-ba63-e371994f9c23', '945e29b0-0001-413e-bbcb-a38c021ca8c5', 'clothing', 'New shoes for growing feet', 'A pair of everyday shoes, sized for a child who has outgrown the last pair.', 'The current shoes are a size too small and are starting to cause blisters on the daily walk to school. A new pair would remove a small but constant source of pain. Growing feet mean this is a need that resurfaces every few months.', 162.28, 162.28, 'MAD', 'high', 'funded', 'Relay point — partner association, Tangier', 'Tangier', 'Tanger-Tetouan-Al Hoceima', ARRAY['clothing','essentials'], '2026-11-15', '2026-03-03T10:15:00', 'Morocco', 'MA', 'seed'),
    ('462d8b27-4981-45c2-97b1-d4bf0f78fe2e', 'b9adbd76-819d-4875-9157-ea52f843b657', '84a782c9-53d8-4c6a-999d-ba67a5819f9a', 'clothing', 'Warm pajamas for winter nights', 'Two sets of warm sleepwear for the cold season.', 'The bedroom is not heated and thin pajamas are not enough to stay warm through the night. Two proper sets would mean fewer disrupted nights and fewer colds this winter. It is a modest request with a direct effect on sleep and health.', 297.85, 297.85, 'MAD', 'medium', 'delivered', 'Relay point — partner association, Agadir', 'Agadir', 'Souss-Massa', ARRAY['winter','clothing'], NULL, '2026-05-02T10:15:00', 'Morocco', 'MA', 'seed'),
    ('0fcd73e2-bf84-4a07-84b5-85658f42549b', '66c0920e-723e-4c9d-846f-5e6db1a6c98a', '4d043fe2-3be7-499a-ac31-037505e8a572', 'technology', 'A tablet for remote classes', 'Also used by the shelter for evening tutoring sessions.', 'Several online classes have been missed simply because no device was free at the right time. A shared tablet would let lessons continue on schedule and support the evening tutoring sessions run by staff. It would benefit more than one child at the same time.', 992.21, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Casablanca', 'Casablanca', 'Casablanca-Settat', ARRAY['education','technology'], NULL, '2026-05-25T10:15:00', 'Morocco', 'MA', 'seed'),
    ('c3f037b5-fd3f-4bd6-90ba-61f227e1c939', '668e8f2c-8c3a-45c1-9518-00e5d570d664', '12f42589-2f85-4e77-af05-b4ea9aa3317a', 'technology', 'A refurbished laptop for coursework', 'A basic, reliable laptop for typed homework and research.', 'Assignments increasingly need to be typed and submitted online, which is difficult without a computer at home. A refurbished laptop would be enough to keep up with coursework and basic research. It is intended for schoolwork rather than entertainment.', 2010.86, 0.0, 'MAD', 'low', 'open', 'Relay point — partner association, Oujda', 'Oujda', 'L''Oriental', ARRAY['education','technology'], NULL, '2026-09-14T10:15:00', 'Morocco', 'MA', 'seed'),
    ('c4c0a4b9-ae07-4816-a5f1-e64f4b9edfd1', 'f816e9b5-401d-46eb-bceb-356c4b93727c', '6cecbcd7-33de-4bd9-8a6a-6c7458c2ecc6', 'technology', 'A basic smartphone to stay in touch', 'An entry-level phone so a caregiver can be reached in an emergency.', 'Coordinating appointments and emergencies has been difficult without a reliable way to reach the family. A simple, basic phone would close that gap without adding an unnecessary expense. It is meant purely for calls and messages, not extras.', 741.99, 185.5, 'MAD', 'critical', 'partially_funded', 'Relay point — partner association, Rabat', 'Rabat', 'Rabat-Sale-Kenitra', ARRAY['technology','family_care'], '2026-12-10', '2026-09-09T10:15:00', 'Morocco', 'MA', 'seed'),
    ('d758d328-0e5f-46cb-83d0-ac56c7d73086', '78304599-3a8a-4658-b960-ce993322f6f7', '9ff42d11-404f-4e6f-b6cf-5a7c9467ddaa', 'technology', 'A printer for schoolwork', 'A basic printer to produce homework and worksheets at home.', 'Printed worksheets are often due the same day they are assigned, leaving no time to find a print shop nearby. A basic home printer would remove that daily scramble entirely. It would be shared across several children in the same household.', 1451.74, 1451.74, 'MAD', 'critical', 'funded', 'Relay point — partner association, Marrakech', 'Marrakech', 'Marrakech-Safi', ARRAY['education','technology'], '2026-11-15', '2026-04-18T10:15:00', 'Morocco', 'MA', 'seed'),
    ('620712ee-4cf7-46a9-9b99-0139245f4764', '0707a521-8fda-4c08-a6ef-75de0c0f0c33', 'fbc85d60-db78-42f8-8131-0c694c6ff3fc', 'sport', 'A ball and a pair of football boots', 'For the kid who dreams of joining the neighborhood team.', 'Practice with the local team happens twice a week, but showing up without boots means sitting out most drills. A ball and a proper pair of boots would let training finally start in earnest. It is a modest cost with a big effect on a child''s confidence.', 302.74, 302.74, 'MAD', 'high', 'delivered', 'Relay point — partner association, Fes', 'Fes', 'Fes-Meknes', ARRAY['sport','hobby'], '2026-11-15', '2026-07-16T10:15:00', 'Morocco', 'MA', 'seed'),
    ('1859bd7f-374c-418f-a07e-82efa1fd5e5e', '556c78a7-baab-46aa-843b-7a0069838891', '945e29b0-0001-413e-bbcb-a38c021ca8c5', 'sport', 'A bicycle for getting to school', 'A basic bicycle to shorten a long daily walk to school.', 'The walk to school currently takes the better part of an hour each way, which eats into study and rest time. A simple bicycle would cut that trip significantly and make the day less exhausting overall. It is transportation as much as it is a sport wish.', 215.2, 0.0, 'MAD', 'high', 'open', 'Relay point — partner association, Tangier', 'Tangier', 'Tanger-Tetouan-Al Hoceima', ARRAY['sport','school'], NULL, '2026-05-03T10:15:00', 'Morocco', 'MA', 'seed'),
    ('d2d67320-dd70-45a4-a189-bed6357750ad', 'b9adbd76-819d-4875-9157-ea52f843b657', '84a782c9-53d8-4c6a-999d-ba67a5819f9a', 'sport', 'A swimsuit and swimming lessons', 'A term of beginner swimming lessons at the local pool.', 'Swimming lessons are offered nearby at a low cost, but even that small fee has been out of reach so far. A full term of lessons, plus a swimsuit, would open up an activity this child has wanted to try for a long time. It is also a useful safety skill to have.', 258.87, 0.0, 'MAD', 'medium', 'open', 'Relay point — partner association, Agadir', 'Agadir', 'Souss-Massa', ARRAY['sport','hobby'], NULL, '2026-03-26T10:15:00', 'Morocco', 'MA', 'seed'),
    ('c2557e5c-bc78-4877-82df-f3f043bd5661', '167652da-1e6b-4cfb-9d3f-6e47d3c88a8a', '4d043fe2-3be7-499a-ac31-037505e8a572', 'sport', 'A basketball and hoop for the courtyard', 'Equipment to set up a small hoop in the shared courtyard.', 'The shared courtyard has enough space for a hoop, but no equipment to make use of it. A ball and a simple hoop would give several children in the building somewhere safe and close by to play. It is a shared gift that benefits more than one household.', 316.84, 57.03, 'MAD', 'high', 'partially_funded', 'Relay point — partner association, Casablanca', 'Casablanca', 'Casablanca-Settat', ARRAY['sport','community'], NULL, '2026-04-14T10:15:00', 'Morocco', 'MA', 'seed'),
    ('ceccf9cc-0de8-4254-97ea-e9be3db72d95', 'cb1ad52e-0fd7-4292-9b37-b3ce419493de', '33ea7b67-f593-4a2b-a04f-c92ca8f47ce3', 'shelter', 'Emergency repairs after storm damage', 'Materials and labor to patch a roof and wall damaged by recent storms.', 'A recent storm tore part of the roof loose and cracked a supporting wall, leaving the home only partly weatherproof. Temporary tarps are holding for now, but a proper repair is needed before the next round of bad weather. The family has been staying with neighbors while the worst-affected room is unusable.', 1487.91, 1487.91, 'MAD', 'high', 'funded', 'Relay point — partner association, Ouarzazate', 'Ouarzazate', 'Draa-Tafilalet', ARRAY['shelter','emergency','urgent'], '2026-11-30', '2026-05-01T10:15:00', 'Morocco', 'MA', 'seed'),
    ('5037bdf5-8c4c-427c-9c4e-eb075b74a3bc', '30e69e67-65d8-488e-8812-5b04eeab0cd6', '12f42589-2f85-4e77-af05-b4ea9aa3317a', 'shelter', 'A temporary shelter tent', 'A weatherproof family tent while permanent repairs are arranged.', 'With part of the home currently unsafe to use, the family has been sleeping in a single crowded room. A proper weatherproof tent would give everyone a dry, secure place to sleep while repairs are arranged. It is meant as a bridge, not a permanent solution.', 1677.24, 1677.24, 'MAD', 'critical', 'delivered', 'Relay point — partner association, Oujda', 'Oujda', 'L''Oriental', ARRAY['shelter','emergency'], '2026-12-20', '2026-03-26T10:15:00', 'Morocco', 'MA', 'seed'),
    ('f8a761d1-d611-404b-a6d7-eb173afb9aee', '565b8975-f91f-4460-b45c-2db9a3d744be', '6cecbcd7-33de-4bd9-8a6a-6c7458c2ecc6', 'shelter', 'Roof repair before the rainy season', 'New sheeting and beams to seal a leaking roof.', 'The roof has been leaking in several spots for months and buckets are no longer enough to manage it. With the rainy season approaching, a proper repair has become urgent rather than optional. Left as is, the leaks risk damaging what little furniture and bedding the family has left.', 1394.97, 0.0, 'MAD', 'critical', 'open', 'Relay point — partner association, Rabat', 'Rabat', 'Rabat-Sale-Kenitra', ARRAY['shelter','urgent'], '2026-12-20', '2026-03-20T10:15:00', 'Morocco', 'MA', 'seed'),
    ('9849210c-377f-47ca-981b-f063f00a80bb', 'dba9ff93-102d-4bad-ae41-b03c72c6ddb7', '9ff42d11-404f-4e6f-b6cf-5a7c9467ddaa', 'shelter', 'A door and window replacement', 'Replacement door and two windows that no longer close properly.', 'The front door does not latch and one window is missing its glass entirely, letting in cold air and rain. Replacing both would make the home secure and far warmer through the winter. It is a basic safety and comfort fix that has been delayed for lack of funds.', 1578.06, 0.0, 'MAD', 'critical', 'open', 'Relay point — partner association, Marrakech', 'Marrakech', 'Marrakech-Safi', ARRAY['shelter','home'], '2026-11-30', '2026-03-09T10:15:00', 'Morocco', 'MA', 'seed'),
    ('547d2cd2-63ec-49b3-b4b8-e4994a7cedf4', '1f5dd5a9-6feb-431f-b615-42775167a51e', 'fbc85d60-db78-42f8-8131-0c694c6ff3fc', 'food', 'Two weeks of groceries, family of five', 'Enough to cook full meals for two weeks.', 'The household''s income has been unpredictable this month, and meals have gotten smaller as a result. Two weeks of groceries would cover the gap until the next steady income arrives. It is meant to bridge a short but real shortfall, not an ongoing need.', 380.87, 198.05, 'MAD', 'high', 'partially_funded', 'Relay point — partner association, Fes', 'Fes', 'Fes-Meknes', ARRAY['food','family','urgent'], '2026-12-10', '2026-06-01T10:15:00', 'Morocco', 'MA', 'seed'),
    ('1616b5fc-4ce5-40b5-8ce4-40dee76c035e', '7e956758-9f1e-4198-b6b4-0a9ffd18d456', '945e29b0-0001-413e-bbcb-a38c021ca8c5', 'food', 'A month of staple food supplies', 'Rice, oil, flour and other basics to last one month.', 'A month of staples such as rice, oil and flour would stretch much further than smaller, day-to-day purchases. Buying in this way is both more affordable and more reliable for a family managing a tight budget. It covers the basics rather than anything beyond essentials.', 507.36, 507.36, 'MAD', 'high', 'funded', 'Relay point — partner association, Tangier', 'Tangier', 'Tanger-Tetouan-Al Hoceima', ARRAY['food','essentials'], NULL, '2026-07-14T10:15:00', 'Morocco', 'MA', 'seed'),
    ('7cca0f97-c8d0-40a5-b436-2bfdf2aafa44', 'b4a9ea14-fbce-4992-b80e-3d102f5dd79c', '33ea7b67-f593-4a2b-a04f-c92ca8f47ce3', 'food', 'Emergency food parcels after flooding', 'Ready meals and clean water for a household affected by recent flooding.', 'Recent flooding damaged the kitchen area and spoiled most of the stored food in the home. Ready-to-eat meals and clean water would cover the days needed to clean up and restock properly. It is short-term, urgent support following a specific event.', 245.77, 245.77, 'MAD', 'high', 'delivered', 'Relay point — partner association, Ouarzazate', 'Ouarzazate', 'Draa-Tafilalet', ARRAY['food','emergency','urgent'], NULL, '2026-07-05T10:15:00', 'Morocco', 'MA', 'seed'),
    ('73fccc5a-cedd-4d6a-bc86-363b6616436c', '4e319579-bf19-4670-8954-adf7c74cead3', '84a782c9-53d8-4c6a-999d-ba67a5819f9a', 'food', 'A gas stove and cooking supplies', 'A replacement stove and basic pots after the old one broke down.', 'The household''s only stove stopped working weeks ago, forcing all meals to be prepared over an open fire outside. A replacement stove and a few basic pots would restore normal cooking indoors, safely and reliably. It is a practical fix for a very ordinary daily task that has become difficult.', 253.14, 0.0, 'MAD', 'medium', 'open', 'Relay point — partner association, Agadir', 'Agadir', 'Souss-Massa', ARRAY['food','essentials'], NULL, '2026-07-23T10:15:00', 'Morocco', 'MA', 'seed');

